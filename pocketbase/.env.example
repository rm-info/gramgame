# Config serveur GramGame — copier en `.env` (fait automatiquement par install.sh).
# Lu par run.sh et par le service systemd (EnvironmentFile). Pas de guillemets.
#
# ⚠️ Les réglages SMTP / URL ci-dessous sont réappliqués à chaque démarrage :
# ils écrasent ce qui serait modifié dans l'admin PocketBase (/_/).

# Adresse d'écoute de PocketBase pour run.sh / systemd (derrière Caddy : rester
# sur 127.0.0.1). Ignorée par l'image Docker, qui écoute toujours sur :8090 dans
# le conteneur. 8092 = PocketBase de dev attendu par vite (vite.config.ts).
PB_HTTP=127.0.0.1:8092

# URL publique de l'app
APP_URL=https://gramgame.lab.rm-info.fr

# Caddy ajoute l'IP du client dans X-Forwarded-For : nécessaire pour que le
# rate limiting voie la vraie IP (et pas 127.0.0.1 pour tout le monde).
TRUSTED_PROXY_HEADERS=X-Forwarded-For

# ── LLM (API compatible OpenAI) ────────────────────────────────────────────
# Gemini (défaut) : clé sur https://aistudio.google.com/app/apikey
LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash
# OpenRouter :
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-haiku-4-5
# Délais d'appel en secondes (défauts 90 / 45), à relever pour un backend lent :
# LLM_TIMEOUT_GENERATE=90
# LLM_TIMEOUT_APPRECIATION=45

# ── Mail (codes de connexion) ──────────────────────────────────────────────
MAIL_SENDER_ADDRESS=gramgame@example.org
MAIL_SENDER_NAME=GramGame
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# true = TLS implicite (port 465) ; false = STARTTLS (port 587)
SMTP_TLS=false
# PLAIN (défaut) ou LOGIN
# SMTP_AUTH_METHOD=PLAIN

# ── Rappels par notification (PWA) ──────────────────────────────────────
# Serveur PUSH (https://push.lab.rm-info.fr/llms.txt) et clé de l'application
# (app_…, identifiant public, pas un secret). Sans clé : pas d'option de rappel.
# PUSH_BASE_URL=https://push.lab.rm-info.fr
PUSH_APP_KEY=

# ── Ressources (machine modeste) ───────────────────────────────────────────
# Plafond souple de mémoire pour le runtime Go
GOMEMLIMIT=128MiB
